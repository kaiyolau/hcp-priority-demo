# Set one of these to enable live LLM explanations. Without a key the API
# falls back to a deterministic, data-only explanation.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override (defaults: claude-haiku-5-5 / gpt-4.1-mini).
LLM_MODEL=
# Feature flag: set to "off" to disable LLM calls entirely.
FEATURE_AI_EXPLAIN=on
